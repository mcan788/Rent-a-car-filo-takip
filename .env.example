# MSSQL Bağlantı Ayarları
# Yerel kullanım için:
# DATABASE_URL=mssql+pyodbc://USER:PASSWORD@SERVER/DATABASE?driver=ODBC+Driver+17+for+SQL+Server

# Örnek (Windows Authentication):
# DATABASE_URL=mssql+pyodbc://@localhost/RentACarDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes

DATABASE_URL=mssql+pyodbc://@localhost/RentACarDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
SECRET_KEY=rentacar-ciro-secret-key-2026
